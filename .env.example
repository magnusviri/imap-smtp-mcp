# Copy this file to .env and replace every placeholder with your local paths
# and a newly generated bearer token. Keep .env private; do not commit it.

# Generate one with: openssl rand -hex 32
PERSONAL_MAIL_MCP_TOKEN=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_TOKEN

# Absolute paths on the host running Docker Compose.
PERSONAL_MAIL_MCP_CONFIG_FILE=/absolute/path/to/config.toml
PERSONAL_MAIL_MCP_GMAIL_SECRET_FILE=/absolute/path/to/gmail-imap-smtp.secret
PERSONAL_MAIL_MCP_TLS_DIR=/absolute/path/to/tls
